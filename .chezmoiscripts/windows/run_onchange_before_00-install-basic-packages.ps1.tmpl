{{ template "colorize_ps1.tmpl" }}

{{ $apps := .apps | fromJson -}}

# Updating and installing apps one-by-one
{{ range $id, $app := $apps -}}
# --- {{ $id }}
{{ if $app.update -}}
    {{ if hasKey $app "update_windows" -}}
        Log-Info "Updating [b][bcyan]{{ $id }}[reset] via its custom command:"
	    Log-Info "[d][i]{{ $app.update_windows }}[reset]"
        {{ $app.update_windows }}
        Log-Success "[b][bcyan]{{ $id }}[reset] updated successfully!"
    {{ else if hasKey $app "winget" -}}
    	Log-Info "Updating [b][bcyan]{{ $id }}[reset] via [b]winget[/b]:"
        winget upgrade --id {{ $app.winget }} -e -i --accept-source-agreements --accept-package-agreements
        Log-Success "[b][bcyan]{{ $id }}[reset] updated successfully!"
    {{ end -}}
{{ else if $app.install -}}
    {{/* The app might be installed already! */}}
    {{ if hasKey $app "install_windows" -}}
        # Check if it is already installed
	if (!(Get-Command {{ $app.bin }} -ErrorAction SilentlyContinue))
	{
	    Log-Info "Installing [b][bcyan]{{ $id }}[reset] via its custom command:"
	    Log-Info "[d][i]{{ $app.update_windows }}[reset]"
	    {{ $app.install_windows }}
	    Log-Success "[b][bcyan]{{ $id }}[reset] installed successfully!"
	}
    {{ else if hasKey $app "winget" -}}
        $is_installed = winget list --id {{ $app.winget }} --accept-source-agreements --accept-package-agreements
	if ($LASTTEXTCODE -ne 0)
	{
	    Log-Info "Installing [b][bcyan]{{ $id }}[reset] via Winget:"
	    winget install --id {{ $app.winget }} -e -i --accept-source-agreements --accept-package-agreements
	    Log-Success "[b][bcyan]{{ $id }}[reset] installed successfully!"
	}
    {{ end -}}
{{ end -}}

{{ end -}}

Log-Success "All apps installed/updated successfully!"

Log-Warn "Don't forget to [b][byellow]restart your shell[reset], its configuration may have updated!"
