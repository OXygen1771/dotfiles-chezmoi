#!/bin/bash

# Colorize output
set_colors()
{
    if [ -t 1 ]; then
        RED='\033[0;31m'
        GREEN='\033[0;32m'
        YELLOW='\033[1;33m'
        BLUE='\033[0;34m'
        NC='\033[0m'
    else
        RED=''
        GREEN=''
        YELLOW=''
        BLUE=''
        NC=''
    fi
}
set_colors

log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
log_err() { echo -e "${RED}[ERROR]${NC} $1"; }

# Generate SSH keypair for Linux, if nonexistent
if [ ! -f "$HOME/.ssh/id_ed25519" ]; then
    log_info "Generating an SSH keypair"
    # Generate an ed25519 keypair with a comment: username-mail@domain.name
    # It will prompt for a passphrase for the key
    log_info "Please enter a secure passphrase for your SSH key and remember it"
    ssh-keygen -t ed25519 -C "{{ .username }}-{{ .email }}" -f "$HOME/.ssh/id_ed25519"
    log_success "SSH key generated successfully"
    log_warn "Don't forget to add this public key to your GitHub (or other) account:"
    cat "$HOME/.ssh/id_ed25519.pub"
fi
