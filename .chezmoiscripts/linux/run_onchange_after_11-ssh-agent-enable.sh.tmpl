#!/bin/bash

# Colorize output
set_colors()
{
    if [ -t 1 ]; then
        RED='\033[0;31m'
        GREEN='\033[0;32m'
        YELLOW='\033[1;33m'
        BLUE='\033[0;34m'
        NC='\033[0m'
    else
        RED=''
        GREEN=''
        YELLOW=''
        BLUE=''
        NC=''
    fi
}
set_colors

log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
log_err() { echo -e "${RED}[ERROR]${NC} $1"; }

if systemctl --user >/dev/null 2>&1; then
    log_info "Enabling ssh-agent systemd service"
    systemctl --user daemon-reload
    systemctl --user enable --now ssh-agent.service
    log_success "ssh-agent started and will start on boot!"
else
    log_err "systemd not found. If this is WSL, enable it in wsl.conf!"
fi

{{ if .is_wsl -}}
log_warn "Do not forget to enable boot.systemd in /etc/wsl.conf!"
log_warn "/etc/wsl.conf\n[boot]\nsystemd=true"
{{- end }}
