{{ if (and (eq .chezmoi.os "linux") (not .is_wsl)) -}}
#!/bin/bash

# Colorize output
set_colors()
{
    if [ -t 1 ]; then
        RED='\033[0;31m'
        GREEN='\033[0;32m'
        YELLOW='\033[1;33m'
        BLUE='\033[0;34m'
        NC='\033[0m'
    else
        RED=''
        GREEN=''
        YELLOW=''
        BLUE=''
        NC=''
    fi
}
set_colors

log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
log_err() { echo -e "${RED}[ERROR]${NC} $1"; }

# Fonts and the font folder
FONT_NAMES=("ttf-jetbrains-mono-nerd")

TO_INSTALL=()
for font in "${FONT_NAMES[@]}"; do
    if ! pacman -Qq "$font" &> /dev/null; then
        TO_INSTALL+=("$font")
    fi
done

if [ ${#TO_INSTALL[@]} -eq 0 ]; then
    log_warn "All fonts are already installed."
    exit 0
fi

log_info "Installing the following fonts: ${TO_INSTALL[@]}"
sudo pacman -S --needed "${TO_INSTALL[@]}"

log_info "Updating font cache"
fc-cache -fv

log_info "Fonts installed successfully"

{{ end -}}
