---@diagnostic disable-next-line
{{ $apps := .apps | fromJson -}}

return {
    "stevearc/conform.nvim",
    opts = {
        formatters_by_ft = {
            python = {
                ---@diagnostic disable-next-line
                {{ if (index $apps "uv").is_installed -}}
                -- fix all auto-fixable errors
                "ruff_fix",
                "ruff_format",
                "ruff_organize_imports",
                {{- end }}
            },
            c = { "clang-format" },
            cpp = { "clang-format" },
        },
        formatters = {
            ["clang-format"] = {
                command = "clang-format",
                args = { "--style=file", "--assume-filename", "$FILENAME" },
                stdin = true,
            },
        },
        format_on_save = {
            timeout_ms = 250,
            lsp_fallback = true,
        },
    },
}
