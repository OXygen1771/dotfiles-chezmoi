fish_add_path $HOME/.local/bin

if status is-interactive
    {{ if $.is_wsl -}}
    # WSL2 GPG_TTY
    set -gx GPG_TTY (tty)
    {{- end }}

    {{ $apps := .apps | fromJson -}}

    {{ if (index $apps "neovim").is_installed -}}
    if command -q nvim
        # set nvim as the main editor
        set -Ux EDITOR '/usr/bin/nvim'
        set -Ux VISUAL '/usr/bin/nvim'
    end
    {{- end }}

    {{ if (index $apps "bat").is_installed -}}
    if command -q bat
        # set bat to PAGER and MANPAGER
        set -Ux PAGER bat
        set -Ux MANPAGER "sh -c 'col -bx | bat -l man -p'"
    end
    {{- end }}
end
