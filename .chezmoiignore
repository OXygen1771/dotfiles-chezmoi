README.md

# Neovim lua lsp config
.luarc.json

{{ $apps := .apps | fromJson -}}

# Ignore linux stuff
{{ if ne .chezmoi.os "linux" }}
.chezmoiscripts/linux/**

# note that .chezmoiignore looks for *target* paths, not source paths
# e.g. the regular .config instead of dot_config in chezmoi source
.config/fish/**
.config/systemd/**
.config/environment.d/**
.config/gitui/**

{{ else }}

# Ignore fish config if not installed
{{ if not (index $apps "fish").is_installed }}
.config/fish/**
{{ end }}

# Ignore gitui config if not installed
{{ if not (index $apps "gitui").is_installed }}
.config/gitui/**
{{ end }}

{{ end }}

# Ignore windows stuff
{{ if ne .chezmoi.os "windows" }}
.chezmoiscripts/windows/**
Documents/**
{{ end }}

# Ignore nvim config if not installed
{{ if not (index $apps "neovim").is_installed }}
.config/nvim/**
{{ else }}
# Ignore uv, ruff and ty specific neovim configs if not installed
# but nvim is installed
{{ if not (index $apps "uv").is_installed }}
.config/nvim/lua/plugins/lsp/python*
{{ end }}
{{ end }}

# Ignore starship config if not installed
{{ if not (index $apps "starship").is_installed }}
.config/starship.toml
{{ end }}
